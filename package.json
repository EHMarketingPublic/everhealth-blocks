{
	"name": "everhealth-blocks",
	"version": "1.0.0",
	"private": true,
	"description": "SCSS build for the everhealth-blocks WordPress plugin.",
	"scripts": {
		"build": "sass blocks:dist/blocks --style=compressed --no-source-map --load-path=assets/scss",
		"watch": "sass blocks:dist/blocks --watch --style=compressed --no-source-map --load-path=assets/scss"
	},
	"devDependencies": {
		"sass": "^1.77.8"
	}
}
